    fun apiValidateToken(request: String?) {
//        isLoading.value = true
        println("testlog"+"..apiGetAadhaarOtp..1"+request)
        val handler = CoroutineExceptionHandler { _, exception ->
        }

        CoroutineScope(Dispatchers.IO + handler).launch {
            try {
                networkRepository.apiValidateToken(request!!).collect { response ->
                    when (response.status) {
                        ApiStatus.LOADING -> {
                            apiResponseStateValidateToken.update { it.copy(isLoading = true) }
                            println("testlog"+"response.message.....1"+response.message)

                        }

                        ApiStatus.SUCCESS -> {
//                            isLoading.value = false
                            encResponseValidateToken.clear()
                            encResponseValidateToken.append(response.data?.response.toString())
                            gotGetValidateTokenAPIResponse.value = true
                            apiResponseStateValidateToken.update {
                                it.copy(
                                    isLoading = false,
                                    errorMessage = "",
                                    response.data

                                )

                            }
                            println("testlog"+"response.message.....2"+response.data)

                        }

                        ApiStatus.ERROR -> {
//                            isLoading.value = false
                            encResponseValidateToken.clear()
                            encResponseValidateToken.append(response.message.toString())
                            gotGetValidateTokenAPIResponse.value = true
                            apiResponseStateValidateToken.update {
                                it.copy(
                                    isLoading = false,
                                    errorMessage = response.message
                                )
                            }
                            println("testlog"+"response.message.....3"+response.message)
                        }
                    }
                    apiStateValidateToken.value = apiResponseStateValidateToken.value.toUiState()
                }
            } catch (e: Exception) {
//                isLoading.value = false
                apiResponseStateValidateToken.update {
                    it.copy(
                        isLoading = false,
                        errorMessage = "Failed to fetch data"
                    )
                }
            }
        }
    }

    sealed class APIStateValidateToken {
        data object Loading : APIStateValidateToken()
        data class Error(val errorMessage: String) : APIStateValidateToken()
        data class Success(val responseData: APIResponse) : APIStateValidateToken()
    }

    private data class APIResponseStateValidateToken(
        val isLoading: Boolean = false,
        val errorMessage: String? = null,
        val responseData: APIResponse? = null
    ) {
        fun toUiState(): APIStateValidateToken {
            return if (isLoading) {
                APIStateValidateToken.Loading
            } else if (errorMessage?.isNotEmpty() == true) {
                APIStateValidateToken.Error(errorMessage)
            } else {
                APIStateValidateToken.Success(responseData!!)
            }
        }
    }
