fun validatePasswordFields() {
    if (textExistingPassword.value?.toString()?.trim()
            .isNullOrEmpty() || textExistingPassword.value?.toString()?.trim().toString()
            .equals("", ignoreCase = true) || textExistingPassword.value?.toString()?.trim().toString()
            .equals("null", ignoreCase = true)
    ) {
        errorMsgExistingPassword.value = "This field is required."
        isValidExistingPassword.value = false
        return
    }
    if (textNewPassword.value?.toString()?.trim()
            .isNullOrEmpty() || textNewPassword.value?.toString()?.trim().toString()
            .equals("", ignoreCase = true) || textNewPassword.value?.toString()?.trim().toString()
            .equals("null", ignoreCase = true)
    ) {
        errorMsgNewPassword.value = "This field is required."
        isValidNewPassword.value = false
        return
    }

    if (textConfirmPassword.value?.toString()?.trim()
            .isNullOrEmpty() || textConfirmPassword.value?.toString()?.trim().toString()
            .equals("", ignoreCase = true) || textConfirmPassword.value?.toString()?.trim().toString()
            .equals("null", ignoreCase = true)
    ) {
        errorMsgConfirmPassword.value = "This field is required."
        isValidConfirmPassword.value = false
        return
    }

    val getChangePasswordRequest = ChangePasswordRequest(getData(KEY_EMPLOYEE_CODE).toString(),
        textExistingPassword.value, textNewPassword.value, textConfirmPassword.value)
    val jsonRequest: String = Json.encodeToString(getChangePasswordRequest)
    val encryptedRequest = getEncryptedRequest(jsonRequest)

    val request = APIRequest(encryptedRequest)
    finalJsonRequest = Json.encodeToString(request)
    println("testlog" + "finalJsonRequest" + finalJsonRequest)
    println("testlog" + "jsonRequest" + jsonRequest)
    println("testlog" + "getChangePasswordRequest" + getChangePasswordRequest)
    println("testlog" + "encryptedRequest" + encryptedRequest)


    isLoadingAPI.value = true
    triggerChangePasswordAPI.value = true

}
