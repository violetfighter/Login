fun isPasswordValid(password: String, userId: String): Boolean {
    val regex = Regex("^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[!@#\$%^&*()_+|~\\-=`{}\\[\\]:\";'<>?,./]).{8,}$")
    if (!regex.matches(password)) return false
    if (password.contains(userId, ignoreCase = true)) return false
    if (password.contains(userId.reversed(), ignoreCase = true)) return false
    return true
}
